        <device Dname="AT32F426K8T7">
          <compile header="Device/Include/at32f422_426.h"  define="AT32F426K8T7"/>
          <memory id="IROM1"  access="rx"       start="0x08000000"  size="0x10000"     startup="1"   default="1"/>
          <memory id="IRAM1"  access="rwx"      start="0x20000000"  size="0x5000"      init   ="0"   default="1"/>
          <algorithm name="Flash/AT32F426_64.FLM"                   start="0x08000000" size="0x10000"   default="1"/>
          <algorithm name="Flash/AT32F426_BOOTMEM_AP.FLM"           start="0x1FFF8000" size="0x07000"   default="0"/>
          <algorithm name="Flash/AT32F426_USD.FLM"                  start="0x1FFFF800" size="0x00200"   default="0"/>
        </device>

        <!-- *************************  Device 'AT32F426KBU7'  ***************************** -->
        <device Dname="AT32F426KBU7">
          <compile header="Device/Include/at32f422_426.h"  define="AT32F426KBU7"/>
          <memory id="IROM1"  access="rx"       start="0x08000000"  size="0x20000"     startup="1"   default="1"/>
          <memory id="IRAM1"  access="rwx"      start="0x20000000"  size="0x5000"      init   ="0"   default="1"/>
          <algorithm name="Flash/AT32F426_128.FLM"                  start="0x08000000" size="0x20000"   default="1"/>
          <algorithm name="Flash/AT32F426_BOOTMEM_AP.FLM"           start="0x1FFF8000" size="0x07000"   default="0"/>
          <algorithm name="Flash/AT32F426_USD.FLM"                  start="0x1FFFF800" size="0x00200"   default="0"/>
        </device>

        <!-- *************************  Device 'AT32F426K8U7'  ***************************** -->
        <device Dname="AT32F426K8U7">
          <compile header="Device/Include/at32f422_426.h"  define="AT32F426K8U7"/>
          <memory id="IROM1"  access="rx"       start="0x08000000"  size="0x10000"     startup="1"   default="1"/>
          <memory id="IRAM1"  access="rwx"      start="0x20000000"  size="0x5000"      init   ="0"   default="1"/>
          <algorithm name="Flash/AT32F426_64.FLM"                   start="0x08000000" size="0x10000"   default="1"/>
          <algorithm name="Flash/AT32F426_BOOTMEM_AP.FLM"           start="0x1FFF8000" size="0x07000"   default="0"/>
          <algorithm name="Flash/AT32F426_USD.FLM"                  start="0x1FFFF800" size="0x00200"   default="0"/>
        </device>

        <!-- *************************  Device 'AT32F426KBU7-4'  ***************************** -->
        <device Dname="AT32F426KBU7-4">
          <compile header="Device/Include/at32f422_426.h"  define="AT32F426KBU7_4"/>
          <memory id="IROM1"  access="rx"       start="0x08000000"  size="0x20000"     startup="1"   default="1"/>
          <memory id="IRAM1"  access="rwx"      start="0x20000000"  size="0x5000"      init   ="0"   default="1"/>
          <algorithm name="Flash/AT32F426_128.FLM"                  start="0x08000000" size="0x20000"   default="1"/>
          <algorithm name="Flash/AT32F426_BOOTMEM_AP.FLM"           start="0x1FFF8000" size="0x07000"   default="0"/>
          <algorithm name="Flash/AT32F426_USD.FLM"                  start="0x1FFFF800" size="0x00200"   default="0"/>
        </device>

        <!-- *************************  Device 'AT32F426K8U7-4'  ***************************** -->
        <device Dname="AT32F426K8U7-4">
          <compile header="Device/Include/at32f422_426.h"  define="AT32F426K8U7_4"/>
          <memory id="IROM1"  access="rx"       start="0x08000000"  size="0x10000"     startup="1"   default="1"/>
          <memory id="IRAM1"  access="rwx"      start="0x20000000"  size="0x5000"      init   ="0"   default="1"/>
