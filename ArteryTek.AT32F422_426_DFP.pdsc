     </subFamily>

    </family>
  </devices>

  <conditions>
    <!-- Compiler Conditions -->
    <condition id="Compiler ARMCC">
      <require Tcompiler="ARMCC"/>
    </condition>

    <!-- Device Conditions -->
    <condition id="AT32F422xx">
      <description>ArteryTek AT32F422 Devices</description>
      <require Dvendor="ArteryTek:143" Dname="AT32F422[CFGK]*"/>
      <require Cclass="Device" Cgroup="Startup" />
    </condition>

    <!-- Device Conditions -->
    <condition id="AT32F426xx">
      <description>ArteryTek AT32F426 Devices</description>
      <require Dvendor="ArteryTek:143" Dname="AT32F426[CFGK]*"/>
      <require Cclass="Device" Cgroup="Startup" />
    </condition>

    <condition id="AT32F422_426">
      <description>ArteryTek AT32F422_426 Devices</description>
      <accept condition="AT32F422xx"/>
      <accept condition="AT32F426xx"/>
    </condition>

    <condition id="AT32F422xx ARMCC">
      <description>ArteryTek AT32F422xx Series devices</description>
      <require Dvendor="ArteryTek:143" Dname="AT32F422[CFGK]*"/>
      <require condition="Compiler ARMCC"/>
    </condition>

    <condition id="AT32F426xx ARMCC">
      <description>ArteryTek AT32F426xx Series devices</description>
      <require Dvendor="ArteryTek:143" Dname="AT32F426[CFGK]*"/>
      <require condition="Compiler ARMCC"/>
    </condition>

    <!-- Device + CMSIS Conditions -->
    <condition id="AT32F422_426 CMSIS">
      <description>ArteryTek AT32F422_426 Devices and CMSIS-CORE</description>
      <require condition="AT32F422_426"/>
      <require Cclass="CMSIS" Cgroup="CORE"/>
      <require Cclass="Device" Cgroup="at32f422_426_conf"/>    
      <require Cclass="Device" Cgroup="at32f422_426_firmware_library" Csub="crm"/>           
    </condition>

    <!-- AT32F422_426 STDPERIPHERALS CRM Conditions -->
    <condition id="AT32F422_426 STDPERIPHERALS CRM">
      <description>ArteryTek AT32F422_426 Standard Peripherals Drivers with CRM</description>
      <require condition="AT32F422_426 CMSIS"/>
      <require Cclass="Device" Cgroup="at32f422_426_firmware_library" Csub="crm"/>
    </condition>

     <!-- AT32F422_426 STDPERIPHERALS MISC Conditions -->
    <condition id="AT32F422_426 STDPERIPHERALS MISC">
      <description>ArteryTek  AT32F422_426 Standard Peripherals Drivers with MISC</description>
      <require condition="AT32F422_426 CMSIS"/>
      <require Cclass="Device" Cgroup="at32f422_426_firmware_library" Csub="misc"/>
    </condition>

     <!-- AT32F422_426 STDPERIPHERALS EVAL Conditions -->
    <condition id="AT32F422_426 STDPERIPHERALS EVB">
      <description>ArteryTek AT32F422_426 Standard Peripherals Drivers with EVB</description>
      <require condition="AT32F422_426 CMSIS"/>
      <require Cclass="Device" Cgroup="at32f422_426_firmware_library" Csub="gpio"/>
      <require Cclass="Device" Cgroup="at32f422_426_firmware_library" Csub="exint"/>
      <require Cclass="Device" Cgroup="at32f422_426_firmware_library" Csub="usart"/>
      <require Cclass="Device" Cgroup="at32f422_426_firmware_library" Csub="scfg"/>
    </condition>
  </conditions>

