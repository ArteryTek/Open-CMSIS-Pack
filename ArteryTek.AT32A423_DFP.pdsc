  <conditions>
    <!-- Compiler Conditions -->
    <condition id="Compiler ARMCC">
      <require Tcompiler="ARMCC"/>
    </condition>

    <!-- Device Conditions -->
    <condition id="AT32A423xx">
      <description>ArteryTek AT32A423 Devices</description>
      <require Dvendor="ArteryTek:143" Dname="AT32A423*"/>
      <require Cclass="Device" Cgroup="Startup" />
    </condition>

    <condition id="AT32A423">
      <description>ArteryTek AT32A423 Devices</description>
      <accept condition="AT32A423xx"/>
    </condition>

    <condition id="AT32A423xx ARMCC">
      <description>ArteryTek AT32A423xx Series devices</description>
      <require Dvendor="ArteryTek:143" Dname="AT32A423*"/>
      <require condition="Compiler ARMCC"/>
    </condition>

    <!-- Device + CMSIS Conditions -->
    <condition id="AT32A423 CMSIS">
      <description>ArteryTek AT32A423 Devices and CMSIS-CORE</description>
      <require condition="AT32A423"/>
      <require Cclass="CMSIS" Cgroup="CORE"/>
      <require Cclass="Device" Cgroup="at32a423_conf"/>    
      <require Cclass="Device" Cgroup="at32a423_firmware_library" Csub="crm"/>           
    </condition>

    <!-- AT32A423 STDPERIPHERALS CRM Conditions -->
    <condition id="AT32A423 STDPERIPHERALS CRM">
      <description>ArteryTek AT32A423 Standard Peripherals Drivers with CRM</description>
      <require condition="AT32A423 CMSIS"/>
      <require Cclass="Device" Cgroup="at32a423_firmware_library" Csub="crm"/>
    </condition>

     <!-- AT32A423 STDPERIPHERALS MISC Conditions -->
    <condition id="AT32A423 STDPERIPHERALS MISC">
      <description>ArteryTek  AT32A423 Standard Peripherals Drivers with MISC</description>
      <require condition="AT32A423 CMSIS"/>
      <require Cclass="Device" Cgroup="at32a423_firmware_library" Csub="misc"/>
    </condition>

     <!-- AT32A423 STDPERIPHERALS EVAL Conditions -->
    <condition id="AT32A423 STDPERIPHERALS EVB">
      <description>ArteryTek AT32A423 Standard Peripherals Drivers with EVB</description>
      <require condition="AT32A423 CMSIS"/>
      <require Cclass="Device" Cgroup="at32a423_firmware_library" Csub="gpio"/>
      <require Cclass="Device" Cgroup="at32a423_firmware_library" Csub="exint"/>
      <require Cclass="Device" Cgroup="at32a423_firmware_library" Csub="usart"/>
      <require Cclass="Device" Cgroup="at32a423_firmware_library" Csub="scfg"/>
    </condition>
  </conditions>

