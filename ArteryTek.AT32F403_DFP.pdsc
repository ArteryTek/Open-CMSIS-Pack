  <conditions>
    <!-- Compiler Conditions -->
    <condition id="Compiler ARMCC">
      <require Tcompiler="ARMCC"/>
    </condition>

    <!-- Device Conditions -->
    <condition id="AT32F403xx">
      <description>ArteryTek AT32F403 Devices</description>
      <require Dvendor="ArteryTek:143" Dname="-AT32F403[CRVZ]*"/>
      <require Cclass="Device" Cgroup="Startup" />
    </condition>

    <condition id="AT32F403">
      <description>ArteryTek AT32F403 Devices</description>
      <accept condition="AT32F403xx"/>
    </condition>

    <!-- Series id Conditions -->
    <condition id="AT32F403xx ARMCC">
      <description>ArteryTek AT32F403xx Series devices</description>
      <require Dvendor="ArteryTek:143" Dname="-AT32F403[CRVZ]*"/>
      <require condition="Compiler ARMCC"/>
    </condition>

    <!-- Device + CMSIS Conditions -->
    <condition id="AT32F403 CMSIS">
      <description>ArteryTek AT32F403 Devices and CMSIS-CORE</description>
      <require condition="AT32F403"/>
      <require Cclass="CMSIS" Cgroup="CORE"/>
      <require Cclass="Device" Cgroup="at32f403_conf"/>    
      <require Cclass="Device" Cgroup="at32f403_firmware_library" Csub="crm"/>           
    </condition>

    <!-- AT32F403 STDPERIPHERALS CRM Conditions -->
    <condition id="AT32F403 STDPERIPHERALS CRM">
      <description>ArteryTek AT32F403 Standard Peripherals Drivers with CRM</description>
      <require condition="AT32F403 CMSIS"/>
      <require Cclass="Device" Cgroup="at32f403_firmware_library" Csub="crm"/>
    </condition>

     <!-- AT32F403 STDPERIPHERALS MISC Conditions -->
    <condition id="AT32F403 STDPERIPHERALS MISC">
      <description>ArteryTek  AT32F403 Standard Peripherals Drivers with MISC</description>
      <require condition="AT32F403 CMSIS"/>
      <require Cclass="Device" Cgroup="at32f403_firmware_library" Csub="misc"/>
    </condition>

     <!-- AT32F403 STDPERIPHERALS EVAL Conditions -->
    <condition id="AT32F403 STDPERIPHERALS EVB">
      <description>ArteryTek AT32F403 Standard Peripherals Drivers with EVB</description>
      <require condition="AT32F403 CMSIS"/>
      <require Cclass="Device" Cgroup="at32f403_firmware_library" Csub="gpio"/>
      <require Cclass="Device" Cgroup="at32f403_firmware_library" Csub="exint"/>
      <require Cclass="Device" Cgroup="at32f403_firmware_library" Csub="usart"/>
    </condition>
  </conditions>

  <components>
  <!-- at32f403_firmware_library -->

    <component Cclass="Device" Cgroup="at32f403_firmware_library" Csub="adc" Cversion="2.0.0" condition="AT32F403 STDPERIPHERALS CRM">
      <description>Analog-to-digital converter (ADC) driver for AT32F403 Devices</description>
        <RTE_Components_h>
        #define RTE_DEVICE_STDPERIPHERALS_ADC
        </RTE_Components_h>
        <files>
          <!-- ADC file -->
          <file category="header" name="Device/Firmware/Peripherals/inc/at32f403_adc.h"/>
          <file category="source" name="Device/Firmware/Peripherals/src/at32f403_adc.c" attr="config" version="2.0.0" />
        </files>
    </component>

    <component Cclass="Device" Cgroup="at32f403_firmware_library" Csub="bpr" Cversion="2.0.0" condition="AT32F403 STDPERIPHERALS CRM">
      <description>Battery Powered Register (BPR) driver for AT32F403 Devices</description>
        <RTE_Components_h>
        #define RTE_DEVICE_STDPERIPHERALS_BPR
        </RTE_Components_h>
        <files>
          <!-- BPR file -->
          <file category="header" name="Device/Firmware/Peripherals/inc/at32f403_bpr.h"/>
          <file category="source" name="Device/Firmware/Peripherals/src/at32f403_bpr.c" attr="config" version="2.0.0" />
        </files>
    </component>

    <component Cclass="Device" Cgroup="at32f403_firmware_library" Csub="crc" Cversion="2.0.0" condition="AT32F403 STDPERIPHERALS CRM">
      <description>Cyclic Redundancy Check (CRC) driver for AT32F403 Devices</description>
        <RTE_Components_h>
        #define RTE_DEVICE_STDPERIPHERALS_CRC
        </RTE_Components_h>
        <files>
          <!-- CRC file -->
          <file category="header" name="Device/Firmware/Peripherals/inc/at32f403_crc.h" />
          <file category="source" name="Device/Firmware/Peripherals/src/at32f403_crc.c" attr="config" version="2.0.0" />
        </files>
    </component>

    <component Cclass="Device" Cgroup="at32f403_firmware_library" Csub="crm" Cversion="2.0.0" condition="AT32F403 STDPERIPHERALS MISC">
      <description>Clock and Reset Management (CRM) driver for AT32F403 Devices</description>
        <RTE_Components_h>
        #define RTE_DEVICE_STDPERIPHERALS_CRM
        </RTE_Components_h>
        <files>
          <!-- CRM file -->
          <file category="header" name="Device/Firmware/Peripherals/inc/at32f403_crm.h" />
          <file category="source" name="Device/Firmware/Peripherals/src/at32f403_crm.c" attr="config" version="2.0.0" />
        </files>
    </component>

    <component Cclass="Device" Cgroup="at32f403_firmware_library" Csub="dac" Cversion="2.0.0" condition="AT32F403 STDPERIPHERALS CRM">
      <description>Digital-to-Analog-to converter (DAC) driver for AT32F403 Devices</description>
        <RTE_Components_h>
        #define RTE_DEVICE_STDPERIPHERALS_CRM
        </RTE_Components_h>
        <files>
          <!-- DAC file -->
