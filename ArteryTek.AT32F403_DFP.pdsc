          <file category="source" name="Device/Firmware/Peripherals/src/at32f403_dac.c" attr="config" version="2.0.0" />
        </files>
    </component>

    <component Cclass="Device" Cgroup="at32f403_firmware_library" Csub="debug" Cversion="2.0.0" condition="AT32F403 STDPERIPHERALS CRM">
      <description>Debug (DEBUG) driver for AT32F403 Devices</description>
        <RTE_Components_h>
        #define RTE_DEVICE_STDPERIPHERALS_DEBUG
        </RTE_Components_h>
        <files>
          <!-- DEBUG file -->
          <file category="header" name="Device/Firmware/Peripherals/inc/at32f403_debug.h" />
          <file category="source" name="Device/Firmware/Peripherals/src/at32f403_debug.c" attr="config" version="2.0.0" />
        </files>
    </component>

    <component Cclass="Device" Cgroup="at32f403_firmware_library" Csub="dma" Cversion="2.0.0" condition="AT32F403 STDPERIPHERALS CRM">
      <description>Direct Memory Access (DMA) driver for AT32F403 Devices</description>
        <RTE_Components_h>
        #define RTE_DEVICE_STDPERIPHERALS_DMA
        </RTE_Components_h>
        <files>
