<?xml version="1.0" encoding="UTF-8"?>
<package schemaVersion="1.2" xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" xs:noNamespaceSchemaLocation="PACK.xsd">
  <vendor>ArteryTek</vendor>
  <url></url>
  <name>AT32F490_DFP</name>
  <description>ArteryTek AT32F4 Series Device Support,Drivers</description>
  <releases>
    <release version="2.0.7" date="2026-11-16" url="https://github.com/ArteryTek/Open-CMSIS-Pack/raw/main/ArteryTek.AT32F490_DFP.2.0.7.pack">
      Update firmware library.
    </release>
    <release version="2.0.6" date="2026-08-28" url="https://github.com/ArteryTek/Open-CMSIS-Pack/raw/main/ArteryTek.AT32F490_DFP.2.0.6.pack">
      change URL.
    </release>
  </releases>
  <keywords>
    <!-- keywords for indexing -->
    <keyword>ArteryTek</keyword>
    <keyword>AT32F490</keyword>
    <keyword>AT32F4</keyword>
  </keywords>

  <devices>
    <!-- ******************************  Cortex-M4  ********************** -->
    <family Dfamily="AT32F49x Series" Dvendor="ArteryTek:143">
      <!--book name="Device/ARM/Documents/??_dgug.pdf"       title="?? Device Generic Users Guide"/-->
    <processor Dcore="Cortex-M4" DcoreVersion="r0p1" Dfpu="1" Dmpu="1" Dtz="NO_TZ" Dendian="Little-endian" />
    <compile header="Device/Include/at32f490.h"/>

      <description>
AT32F4 is a new 32-bit high performance, low power consumption universal microcontroller family powered by the ARM Cortex-M4 RISC core,which targeted at various MCU application areas.
AT32F4 family integrates features to simplify system design and provide customers wide range of comprehensive and superior cost effective MCU portfolios with proven technology and great innovation.
      </description>    

      <!-- ************************  Subfamily 'AT32F490'  **************************** -->
      <subFamily DsubFamily="AT32F490">
      <processor  Dfpu="1" Dclock="216000000"/>
      <debug svd="SVD/AT32F490xx_v2.svd"/>
      <description>
AT32F490 - ARM Cortex-M4 Core
  Frequency up to 216 MHz
  Single-cycle multiplier and hardware divider
  NVIC support 16 internal, 68 external interrupts, each has 16 priority levels

Memories
  Flash size up to 256 KB
  SRAM size up to 102 KB

Low power management
  Power saving mode: sleep,deep-sleep and standby mode

Advanced analog peripherals
  Up to 1 x 12bit ADC

Integrated peripherals interface
  Up to 8 x USART/UART/Irda/LIN/ISO7816
  Up to 3 x SPI
  Up to 3 x I2C

On-chip resources
  Up to 1 x 16 bit Advanced Timer, 1 x SysTick Timer, 8 x 16 bit GPTM, 1 x 32 bit GPTM, 2 x WDT, 1 x ERTC
  2 * 7-chs DMA support: Timers, ADC, SPIs, I2Cs, USARTs ets
  System supervisor and reset: POR,PDR,LVD
  80% GPIO available
  32-bit CRC, 96-bit unique ID
  On-chip clock: HICK (8MHz), LICK (40KHz)
      </description>

      <feature type="WDT"           n="2"/>
      <feature type="RTC"           n="32768"/>
      <feature type="ADC"           n="1"       m="12"/>
      <feature type="Temp"          n="-40"     m="105"/>
      <feature type="VCC"           n="2.60"    m="3.60"/>

      <!-- *************************  Device 'AT32F490RCT7'  ***************************** -->
      <device Dname="AT32F490RCT7">
        <compile header="Device/Include/at32f490.h"  define="AT32F490RCT7"/>
        <memory id="IROM1"  access="rx"       start="0x08000000"  size="0x40000"      startup="1"   default="1"/>
        <memory id="IRAM1"  access="rwx"      start="0x20000000"  size="0x19800"      init   ="0"   default="1"/>
        <algorithm name="Flash/AT32F490_256.FLM"                start="0x08000000" size="0x40000"   default="1"/>
        <algorithm name="Flash/AT32F490_BOOTMEM_AP.FLM"         start="0x1FFFA400" size="0x05000"   default="0"/>
        <algorithm name="Flash/AT32F490_USD.FLM"                start="0x1FFFF800" size="0x00200"   default="0"/>
      </device>

     </subFamily>
    </family>
  </devices>

  <conditions>
    <!-- Compiler Conditions -->
    <condition id="Compiler ARMCC">
      <require Tcompiler="ARMCC"/>
    </condition>

    <!-- Device Conditions -->
    <condition id="AT32F490xx">
      <description>ArteryTek AT32F490 Devices</description>
      <require Dvendor="ArteryTek:143" Dname="AT32F490*"/>
      <require Cclass="Device" Cgroup="Startup" />
    </condition>

    <condition id="AT32F490">
      <description>ArteryTek AT32F490 Devices</description>
      <accept condition="AT32F490xx"/>
    </condition>

    <condition id="AT32F490xx ARMCC">
      <description>ArteryTek AT32F490xx Series devices</description>
      <require Dvendor="ArteryTek:143" Dname="AT32F490*"/>
      <require condition="Compiler ARMCC"/>
    </condition>

    <!-- Device + CMSIS Conditions -->
    <condition id="AT32F490 CMSIS">
      <description>ArteryTek AT32F490 Devices and CMSIS-CORE</description>
      <require condition="AT32F490"/>
      <require Cclass="CMSIS" Cgroup="CORE"/>
      <require Cclass="Device" Cgroup="at32f490_conf"/>    
      <require Cclass="Device" Cgroup="at32f490_firmware_library" Csub="crm"/>           
    </condition>

    <!-- AT32F490 STDPERIPHERALS CRM Conditions -->
    <condition id="AT32F490 STDPERIPHERALS CRM">
      <description>ArteryTek AT32F490 Standard Peripherals Drivers with CRM</description>
      <require condition="AT32F490 CMSIS"/>
      <require Cclass="Device" Cgroup="at32f490_firmware_library" Csub="crm"/>
    </condition>

     <!-- AT32F490 STDPERIPHERALS MISC Conditions -->
    <condition id="AT32F490 STDPERIPHERALS MISC">
      <description>ArteryTek  AT32F490 Standard Peripherals Drivers with MISC</description>
      <require condition="AT32F490 CMSIS"/>
      <require Cclass="Device" Cgroup="at32f490_firmware_library" Csub="misc"/>
    </condition>

     <!-- AT32F490 STDPERIPHERALS EVAL Conditions -->
    <condition id="AT32F490 STDPERIPHERALS EVB">
      <description>ArteryTek AT32F490 Standard Peripherals Drivers with EVB</description>
      <require condition="AT32F490 CMSIS"/>
      <require Cclass="Device" Cgroup="at32f490_firmware_library" Csub="gpio"/>
      <require Cclass="Device" Cgroup="at32f490_firmware_library" Csub="exint"/>
      <require Cclass="Device" Cgroup="at32f490_firmware_library" Csub="usart"/>
      <require Cclass="Device" Cgroup="at32f490_firmware_library" Csub="scfg"/>
    </condition>
  </conditions>

