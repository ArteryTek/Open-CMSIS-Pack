  <devices>
    <!-- ******************************  Cortex-M4  ********************** -->
    <family Dfamily="AT32F40x Series" Dvendor="ArteryTek:143">
      <!--book name="Device/ARM/Documents/??_dgug.pdf"       title="?? Device Generic Users Guide"/-->
    <processor Dcore="Cortex-M4" DcoreVersion="r0p1" Dfpu="1" Dmpu="1" Dtz="NO_TZ" Dendian="Little-endian" />
    <compile header="Device/Include/at32f402_405.h"/>

      <description>
AT32F4 is a new 32-bit high performance, low power consumption universal microcontroller family powered by the ARM Cortex-M4 RISC core,which targeted at various MCU application areas.
AT32F4 family integrates features to simplify system design and provide customers wide range of comprehensive and superior cost effective MCU portfolios with proven technology and great innovation.
      </description>    

      <!-- ************************  Subfamily 'AT32F402'  **************************** -->
      <subFamily DsubFamily="AT32F402">
      <processor  Dfpu="1" Dclock="216000000"/>
      <debug svd="SVD/AT32F402xx_v2.svd"/>
      <description>
AT32F402 - ARM Cortex-M4 Core
  Frequency up to 216 MHz
  Single-cycle multiplier and hardware divider
  NVIC support 16 internal, 68 external interrupts, each has 16 priority levels

Memories
  Flash size up to 256 KB
  SRAM size up to 102 KB

Low power management
  Power saving mode: sleep,deep-sleep and standby mode

Advanced analog peripherals
  Up to 1 x 12bit ADC

Integrated peripherals interface
  Up to 8 x USART/UART/Irda/LIN/ISO7816
  Up to 3 x SPI
  Up to 3 x I2C

On-chip resources
  Up to 1 x 16 bit Advanced Timer, 1 x SysTick Timer, 8 x 16 bit GPTM, 1 x 32 bit GPTM, 2 x WDT, 1 x ERTC
  2 * 7-chs DMA support: Timers, ADC, SPIs, I2Cs, USARTs ets
  System supervisor and reset: POR,PDR,LVD
  80% GPIO available
  32-bit CRC, 96-bit unique ID
  On-chip clock: HICK (8MHz), LICK (40KHz)
      </description>

      <feature type="WDT"           n="2"/>
      <feature type="RTC"           n="32768"/>
      <feature type="ADC"           n="1"       m="12"/>
      <feature type="Temp"          n="-40"     m="105"/>
      <feature type="VCC"           n="2.60"    m="3.60"/>

      <!-- *************************  Device 'AT32F402KBU7-4'  ***************************** -->
      <device Dname="AT32F402KBU7-4">
        <compile header="Device/Include/at32f402_405.h"  define="AT32F402KBU7_4"/>
        <memory id="IROM1"  access="rx"       start="0x08000000"  size="0x20000"      startup="1"   default="1"/>
        <memory id="IRAM1"  access="rwx"      start="0x20000000"  size="0x11800"      init   ="0"   default="1"/>
        <algorithm name="Flash/AT32F402_128.FLM"                start="0x08000000" size="0x20000"   default="1"/>
        <algorithm name="Flash/AT32F402_BOOTMEM_AP.FLM"         start="0x1FFFA400" size="0x05000"   default="0"/>
        <algorithm name="Flash/AT32F402_USD.FLM"                start="0x1FFFF800" size="0x00200"   default="0"/>
      </device>

      <!-- *************************  Device 'AT32F402KCU7-4'  ***************************** -->
