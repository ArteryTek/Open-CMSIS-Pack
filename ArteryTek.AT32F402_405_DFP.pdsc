  <conditions>
    <!-- Compiler Conditions -->
    <condition id="Compiler ARMCC">
      <require Tcompiler="ARMCC"/>
    </condition>

    <!-- Device Conditions -->
    <condition id="AT32F402xx">
      <description>ArteryTek AT32F402 Devices</description>
      <require Dvendor="ArteryTek:143" Dname="AT32F402*"/>
      <require Cclass="Device" Cgroup="Startup" />
    </condition>

    <condition id="AT32F405xx">
      <description>ArteryTek AT32F405 Devices</description>
      <require Dvendor="ArteryTek:143" Dname="AT32F405*"/>
      <require Cclass="Device" Cgroup="Startup" />
    </condition>

    <condition id="AT32F402_405">
      <description>ArteryTek AT32F402_405 Devices</description>
      <accept condition="AT32F402xx"/>
      <accept condition="AT32F405xx"/>
    </condition>

    <condition id="AT32F402xx ARMCC">
      <description>ArteryTek AT32F402xx Series devices</description>
      <require Dvendor="ArteryTek:143" Dname="AT32F402*"/>
      <require condition="Compiler ARMCC"/>
    </condition>

    <condition id="AT32F405xx ARMCC">
      <description>ArteryTek AT32F405xx Series devices</description>
      <require Dvendor="ArteryTek:143" Dname="AT32F405*"/>
      <require condition="Compiler ARMCC"/>
    </condition>

    <!-- Device + CMSIS Conditions -->
    <condition id="AT32F402_405 CMSIS">
      <description>ArteryTek AT32F402_405 Devices and CMSIS-CORE</description>
      <require condition="AT32F402_405"/>
      <require Cclass="CMSIS" Cgroup="CORE"/>
      <require Cclass="Device" Cgroup="at32f402_405_conf"/>    
      <require Cclass="Device" Cgroup="at32f402_405_firmware_library" Csub="crm"/>           
    </condition>

    <!-- AT32F402_405 STDPERIPHERALS CRM Conditions -->
    <condition id="AT32F402_405 STDPERIPHERALS CRM">
      <description>ArteryTek AT32F402_405 Standard Peripherals Drivers with CRM</description>
