  <name>AT32F402_405_DFP</name>
  <description>ArteryTek AT32F4 Series Device Support,Drivers</description>
  <releases>
    <release version="2.1.6" date="2026-08-28" url="https://github.com/ArteryTek/Open-CMSIS-Pack/raw/main/ArteryTek.AT32F402_405_DFP.2.1.6.pack">
      change URL.
