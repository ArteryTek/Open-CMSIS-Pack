  <conditions>
    <!-- Compiler Conditions -->
    <condition id="Compiler ARMCC">
      <require Tcompiler="ARMCC"/>
    </condition>

    <!-- Device Conditions -->
    <condition id="AT32F425xx">
      <description>ArteryTek AT32F425 Devices</description>
      <require Dvendor="ArteryTek:143" Dname="-AT32F425[CFKR]*"/>
      <require Cclass="Device" Cgroup="Startup" />
    </condition>

    <condition id="AT32F425">
      <description>ArteryTek AT32F425 Devices</description>
      <accept condition="AT32F425xx"/>
    </condition>

    <!-- Series id Conditions -->
    <condition id="AT32F425xx ARMCC">
      <description>ArteryTek AT32F425xx Series devices</description>
      <require Dvendor="ArteryTek:143" Dname="-AT32F425[CFKR]*"/>
      <require condition="Compiler ARMCC"/>
    </condition>

    <!-- Device + CMSIS Conditions -->
    <condition id="AT32F425 CMSIS">
      <description>ArteryTek AT32F425 Devices and CMSIS-CORE</description>
      <require condition="AT32F425"/>
      <require Cclass="CMSIS" Cgroup="CORE"/>
      <require Cclass="Device" Cgroup="at32f425_conf"/>    
      <require Cclass="Device" Cgroup="at32f425_firmware_library" Csub="crm"/>           
    </condition>

    <!-- AT32F425 STDPERIPHERALS CRM Conditions -->
    <condition id="AT32F425 STDPERIPHERALS CRM">
      <description>ArteryTek AT32F425 Standard Peripherals Drivers with CRM</description>
      <require condition="AT32F425 CMSIS"/>
      <require Cclass="Device" Cgroup="at32f425_firmware_library" Csub="crm"/>
    </condition>

     <!-- AT32F425 STDPERIPHERALS MISC Conditions -->
    <condition id="AT32F425 STDPERIPHERALS MISC">
      <description>ArteryTek  AT32F425 Standard Peripherals Drivers with MISC</description>
      <require condition="AT32F425 CMSIS"/>
      <require Cclass="Device" Cgroup="at32f425_firmware_library" Csub="misc"/>
    </condition>

     <!-- AT32F425 STDPERIPHERALS EVAL Conditions -->
    <condition id="AT32F425 STDPERIPHERALS EVB">
      <description>ArteryTek AT32F425 Standard Peripherals Drivers with EVB</description>
      <require condition="AT32F425 CMSIS"/>
      <require Cclass="Device" Cgroup="at32f425_firmware_library" Csub="gpio"/>
      <require Cclass="Device" Cgroup="at32f425_firmware_library" Csub="exint"/>
      <require Cclass="Device" Cgroup="at32f425_firmware_library" Csub="usart"/>
    </condition>
  </conditions>

  <components>
  <!-- at32f425_firmware_library -->
    <component Cclass="Device" Cgroup="at32f425_firmware_library" Csub="acc" Cversion="2.0.0" condition="AT32F425 STDPERIPHERALS CRM">
      <description>Auto Clock Calibration (ACC) driver for AT32F425 Devices</description>
        <RTE_Components_h>
        #define RTE_DEVICE_STDPERIPHERALS_ACC
        </RTE_Components_h>
        <files>
          <!-- ACC file -->
          <file category="header" name="Device/Firmware/Peripherals/inc/at32f425_acc.h"/>
          <file category="source" name="Device/Firmware/Peripherals/src/at32f425_acc.c" attr="config" version="2.0.0" />
        </files>
    </component>

    <component Cclass="Device" Cgroup="at32f425_firmware_library" Csub="adc" Cversion="2.0.0" condition="AT32F425 STDPERIPHERALS CRM">
      <description>Analog-to-digital converter (ADC) driver for AT32F425 Devices</description>
