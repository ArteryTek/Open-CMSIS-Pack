        <memory id="IROM1"  access="rx"       start="0x08000000"  size="0x80000"      startup="1"   default="1"/>
        <memory id="IRAM1"  access="rwx"      start="0x20000000"  size="0x24000"      init   ="0"   default="1"/>
        <algorithm name="Flash/AT32F457_512.FLM"                start="0x08000000" size="0x80000"   default="1"/>
        <algorithm name="Flash/AT32F457_BOOTMEM_AP.FLM"         start="0x1FFF7C00" size="0x06800"   default="0"/>
        <algorithm name="Flash/AT32F457_USD.FLM"                start="0x1FFF8000" size="0x00200"   default="0"/>
      </device>

      <!-- *************************  Device 'AT32F457VCT7'  ***************************** -->
      <device Dname="AT32F457VCT7">
        <compile header="Device/Include/at32f45x.h"  define="AT32F457VCT7"/>
        <memory id="IROM1"  access="rx"       start="0x08000000"  size="0x40000"      startup="1"   default="1"/>
        <memory id="IRAM1"  access="rwx"      start="0x20000000"  size="0x1B000"      init   ="0"   default="1"/>
        <algorithm name="Flash/AT32F457_256.FLM"                start="0x08000000" size="0x40000"   default="1"/>
        <algorithm name="Flash/AT32F457_BOOTMEM_AP.FLM"         start="0x1FFF7C00" size="0x06800"   default="0"/>
        <algorithm name="Flash/AT32F457_USD.FLM"                start="0x1FFF8000" size="0x00200"   default="0"/>
      </device>

      <!-- *************************  Device 'AT32F457VET7'  ***************************** -->
      <device Dname="AT32F457VET7">
        <compile header="Device/Include/at32f45x.h"  define="AT32F457VET7"/>
        <memory id="IROM1"  access="rx"       start="0x08000000"  size="0x80000"      startup="1"   default="1"/>
        <memory id="IRAM1"  access="rwx"      start="0x20000000"  size="0x24000"      init   ="0"   default="1"/>
        <algorithm name="Flash/AT32F457_512.FLM"                start="0x08000000" size="0x80000"   default="1"/>
        <algorithm name="Flash/AT32F457_BOOTMEM_AP.FLM"         start="0x1FFF7C00" size="0x06800"   default="0"/>
        <algorithm name="Flash/AT32F457_USD.FLM"                start="0x1FFF8000" size="0x00200"   default="0"/>
      </device>

      <!-- *************************  Device 'AT32F457ZCT7'  ***************************** -->
      <device Dname="AT32F457ZCT7">
        <compile header="Device/Include/at32f45x.h"  define="AT32F457ZCT7"/>
        <memory id="IROM1"  access="rx"       start="0x08000000"  size="0x40000"      startup="1"   default="1"/>
        <memory id="IRAM1"  access="rwx"      start="0x20000000"  size="0x1B000"      init   ="0"   default="1"/>
        <algorithm name="Flash/AT32F457_256.FLM"                start="0x08000000" size="0x40000"   default="1"/>
        <algorithm name="Flash/AT32F457_BOOTMEM_AP.FLM"         start="0x1FFF7C00" size="0x06800"   default="0"/>
        <algorithm name="Flash/AT32F457_USD.FLM"                start="0x1FFF8000" size="0x00200"   default="0"/>
      </device>

      <!-- *************************  Device 'AT32F457ZET7'  ***************************** -->
      <device Dname="AT32F457ZET7">
        <compile header="Device/Include/at32f45x.h"  define="AT32F457ZET7"/>
        <memory id="IROM1"  access="rx"       start="0x08000000"  size="0x80000"      startup="1"   default="1"/>
        <memory id="IRAM1"  access="rwx"      start="0x20000000"  size="0x24000"      init   ="0"   default="1"/>
        <algorithm name="Flash/AT32F457_512.FLM"                start="0x08000000" size="0x80000"   default="1"/>
        <algorithm name="Flash/AT32F457_BOOTMEM_AP.FLM"         start="0x1FFF7C00" size="0x06800"   default="0"/>
        <algorithm name="Flash/AT32F457_USD.FLM"                start="0x1FFF8000" size="0x00200"   default="0"/>
      </device>

     </subFamily>
    </family>
  </devices>

  <conditions>
    <!-- Compiler Conditions -->
    <condition id="Compiler ARMCC">
      <require Tcompiler="ARMCC"/>
    </condition>

    <!-- Device Conditions -->
    <condition id="AT32F455xx">
      <description>ArteryTek AT32F455x Devices</description>
      <require Dvendor="ArteryTek:143" Dname="AT32F455*"/>
      <require Cclass="Device" Cgroup="Startup" />
    </condition>

    <condition id="AT32F456xx">
      <description>ArteryTek AT32F456x Devices</description>
      <require Dvendor="ArteryTek:143" Dname="AT32F456*"/>
      <require Cclass="Device" Cgroup="Startup" />
    </condition>

    <condition id="AT32F457xx">
      <description>ArteryTek AT32F457x Devices</description>
      <require Dvendor="ArteryTek:143" Dname="AT32F457*"/>
      <require Cclass="Device" Cgroup="Startup" />
    </condition>

    <condition id="AT32F45x">
      <description>ArteryTek AT32F45x Devices</description>
      <accept condition="AT32F455xx"/>
      <accept condition="AT32F456xx"/>
      <accept condition="AT32F457xx"/>
    </condition>

    <condition id="AT32F455xx ARMCC">
      <description>ArteryTek AT32F455xx Series devices</description>
      <require Dvendor="ArteryTek:143" Dname="AT32F455*"/>
      <require condition="Compiler ARMCC"/>
    </condition>

    <condition id="AT32F456xx ARMCC">
      <description>ArteryTek AT32F456xx Series devices</description>
      <require Dvendor="ArteryTek:143" Dname="AT32F456*"/>
      <require condition="Compiler ARMCC"/>
    </condition>

    <condition id="AT32F457xx ARMCC">
      <description>ArteryTek AT32F457xx Series devices</description>
      <require Dvendor="ArteryTek:143" Dname="AT32F457*"/>
      <require condition="Compiler ARMCC"/>
    </condition>

    <!-- Device + CMSIS Conditions -->
    <condition id="AT32F45x CMSIS">
      <description>ArteryTek AT32F45x Devices and CMSIS-CORE</description>
      <require condition="AT32F45x"/>
      <require Cclass="CMSIS" Cgroup="CORE"/>
      <require Cclass="Device" Cgroup="at32f45x_conf"/>    
      <require Cclass="Device" Cgroup="at32f45x_firmware_library" Csub="crm"/>           
    </condition>

    <!-- AT32F45x STDPERIPHERALS CRM Conditions -->
    <condition id="AT32F45x STDPERIPHERALS CRM">
      <description>ArteryTek AT32F45x Standard Peripherals Drivers with CRM</description>
      <require condition="AT32F45x CMSIS"/>
      <require Cclass="Device" Cgroup="at32f45x_firmware_library" Csub="crm"/>
    </condition>

     <!-- AT32F45x STDPERIPHERALS MISC Conditions -->
    <condition id="AT32F45x STDPERIPHERALS MISC">
      <description>ArteryTek  AT32F45x Standard Peripherals Drivers with MISC</description>
      <require condition="AT32F45x CMSIS"/>
      <require Cclass="Device" Cgroup="at32f45x_firmware_library" Csub="misc"/>
    </condition>

     <!-- AT32F45x STDPERIPHERALS EVAL Conditions -->
    <condition id="AT32F45x STDPERIPHERALS EVB">
      <description>ArteryTek AT32F45x Standard Peripherals Drivers with EVB</description>
      <require condition="AT32F45x CMSIS"/>
      <require Cclass="Device" Cgroup="at32f45x_firmware_library" Csub="gpio"/>
      <require Cclass="Device" Cgroup="at32f45x_firmware_library" Csub="exint"/>
      <require Cclass="Device" Cgroup="at32f45x_firmware_library" Csub="usart"/>
      <require Cclass="Device" Cgroup="at32f45x_firmware_library" Csub="scfg"/>
    </condition>
  </conditions>

