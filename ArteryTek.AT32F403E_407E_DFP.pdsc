          <algorithm name="Flash/AT32F403E_USD.FLM"                      start="0x1FFFF800" size="0x00040"   default="0"/>
        </device>

        <!-- *************************  Device 'AT32F403ECPT7'  ***************************** -->
        <device Dname="AT32F403ECPT7">
          <compile header="Device/Include/at32f403e_407e.h"  define="AT32F403ECPT7"/>
