          <memory id="IRAM1"  access="rwx"      start="0x20000000"         size="0x18000"     init   ="0"      default="1"/>
          <algorithm name="Flash/AT32F407E_256.FLM"                         start="0x08000000" size="0x40000"   default="1"/>
          <algorithm name="Flash/AT32F407E_USD.FLM"                         start="0x1FFFF800" size="0x00040"   default="0"/>
        </device>

        <!-- *************************  Device 'AT32F407ERDT7'  ***************************** -->
        <device Dname="AT32F407ERDT7">
          <compile header="Device/Include/at32f403e_407e.h"  define="AT32F407ERDT7"/>
