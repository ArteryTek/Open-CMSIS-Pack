  <conditions>
    <!-- Compiler Conditions -->
    <condition id="Compiler ARMCC">
      <require Tcompiler="ARMCC"/>
    </condition>

    <!-- Device Conditions -->
    <condition id="AT32F403Exx">
      <description>ArteryTek AT32F403E Devices</description>
      <require Dvendor="ArteryTek:143" Dname="AT32F403E*"/>
      <require Cclass="Device" Cgroup="Startup" />
    </condition>

    <condition id="AT32F407Exx">
      <description>ArteryTek AT32F407E Devices</description>
      <require Dvendor="ArteryTek:143" Dname="AT32F407E*"/>
      <require Cclass="Device" Cgroup="Startup" />
    </condition>

    <condition id="AT32F403E_407E">
      <description>ArteryTek AT32F403E_407E Devices</description>
      <accept condition="AT32F403Exx"/>
      <accept condition="AT32F407Exx"/>
    </condition>

    <condition id="AT32F403Exx ARMCC">
      <description>ArteryTek AT32F403Exx Series devices</description>
      <require Dvendor="ArteryTek:143" Dname="AT32F403E*"/>
      <require condition="Compiler ARMCC"/>
    </condition>

    <condition id="AT32F407Exx ARMCC">
      <description>ArteryTek AT32F407Exx Series devices</description>
      <require Dvendor="ArteryTek:143" Dname="AT32F407E*"/>
      <require condition="Compiler ARMCC"/>
    </condition>

    <!-- Device + CMSIS Conditions -->
    <condition id="AT32F403E_407E CMSIS">
      <description>ArteryTek AT32F403E_407E Devices and CMSIS-CORE</description>
      <require condition="AT32F403E_407E"/>
      <require Cclass="CMSIS" Cgroup="CORE"/>
      <require Cclass="Device" Cgroup="at32f403e_407e_conf"/>    
      <require Cclass="Device" Cgroup="at32f403e_407e_firmware_library" Csub="crm"/>           
    </condition>

    <!-- AT32F403E_407E STDPERIPHERALS CRM Conditions -->
    <condition id="AT32F403E_407E STDPERIPHERALS CRM">
      <description>ArteryTek AT32F403E_407E Standard Peripherals Drivers with CRM</description>
      <require condition="AT32F403E_407E CMSIS"/>
      <require Cclass="Device" Cgroup="at32f403e_407e_firmware_library" Csub="crm"/>
    </condition>

     <!-- AT32F403E_407E STDPERIPHERALS MISC Conditions -->
    <condition id="AT32F403E_407E STDPERIPHERALS MISC">
      <description>ArteryTek  AT32F403E_407E Standard Peripherals Drivers with MISC</description>
      <require condition="AT32F403E_407E CMSIS"/>
      <require Cclass="Device" Cgroup="at32f403e_407e_firmware_library" Csub="misc"/>
    </condition>

     <!-- AT32F403E_407E STDPERIPHERALS EVAL Conditions -->
    <condition id="AT32F403E_407E STDPERIPHERALS EVB">
      <description>ArteryTek AT32F403E_407E Standard Peripherals Drivers with EVB</description>
      <require condition="AT32F403E_407E CMSIS"/>
      <require Cclass="Device" Cgroup="at32f403e_407e_firmware_library" Csub="gpio"/>
      <require Cclass="Device" Cgroup="at32f403e_407e_firmware_library" Csub="exint"/>
      <require Cclass="Device" Cgroup="at32f403e_407e_firmware_library" Csub="usart"/>
    </condition>
  </conditions>

  <components>
  <!-- at32f403e_407e_firmware_library -->
    <component Cclass="Device" Cgroup="at32f403e_407e_firmware_library" Csub="acc" Cversion="2.0.0" condition="AT32F403E_407E STDPERIPHERALS CRM">
      <description>Auto Clock Calibration (ACC) driver for AT32F403E_407E Devices</description>
        <RTE_Components_h>
        #define RTE_DEVICE_STDPERIPHERALS_ACC
        </RTE_Components_h>
        <files>
          <!-- ACC file -->
          <file category="header" name="Device/Firmware/Peripherals/inc/at32f403e_407e_acc.h"/>
          <file category="source" name="Device/Firmware/Peripherals/src/at32f403e_407e_acc.c" attr="config" version="2.0.0" />
        </files>
    </component>

    <component Cclass="Device" Cgroup="at32f403e_407e_firmware_library" Csub="adc" Cversion="2.0.0" condition="AT32F403E_407E STDPERIPHERALS CRM">
      <description>Analog-to-digital converter (ADC) driver for AT32F403E_407E Devices</description>
        <RTE_Components_h>
        #define RTE_DEVICE_STDPERIPHERALS_ADC
        </RTE_Components_h>
        <files>
          <!-- ADC file -->
          <file category="header" name="Device/Firmware/Peripherals/inc/at32f403e_407e_adc.h"/>
          <file category="source" name="Device/Firmware/Peripherals/src/at32f403e_407e_adc.c" attr="config" version="2.0.0" />
        </files>
    </component>

    <component Cclass="Device" Cgroup="at32f403e_407e_firmware_library" Csub="bpr" Cversion="2.0.0" condition="AT32F403E_407E STDPERIPHERALS CRM">
      <description>Battery Powered Register (BPR) driver for AT32F403E_407E Devices</description>
        <RTE_Components_h>
        #define RTE_DEVICE_STDPERIPHERALS_BPR
        </RTE_Components_h>
        <files>
          <!-- BPR file -->
          <file category="header" name="Device/Firmware/Peripherals/inc/at32f403e_407e_bpr.h"/>
          <file category="source" name="Device/Firmware/Peripherals/src/at32f403e_407e_bpr.c" attr="config" version="2.0.0" />
        </files>
    </component>

    <component Cclass="Device" Cgroup="at32f403e_407e_firmware_library" Csub="can" Cversion="2.0.0" condition="AT32F403E_407E STDPERIPHERALS CRM">
      <description>CAN (CAN) driver for AT32F403E_407E Devices</description>
        <RTE_Components_h>
        #define RTE_DEVICE_STDPERIPHERALS_CAN
        </RTE_Components_h>
        <files>
          <!-- CAN file -->
          <file category="header" name="Device/Firmware/Peripherals/inc/at32f403e_407e_can.h" />
          <file category="source" name="Device/Firmware/Peripherals/src/at32f403e_407e_can.c" attr="config" version="2.0.0" />
        </files>
    </component>

    <component Cclass="Device" Cgroup="at32f403e_407e_firmware_library" Csub="crc" Cversion="2.0.0" condition="AT32F403E_407E STDPERIPHERALS CRM">
      <description>Cyclic Redundancy Check (CRC) driver for AT32F403E_407E Devices</description>
        <RTE_Components_h>
        #define RTE_DEVICE_STDPERIPHERALS_CRC
        </RTE_Components_h>
        <files>
