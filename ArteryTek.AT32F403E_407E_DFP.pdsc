<?xml version="1.0" encoding="UTF-8"?>
<package schemaVersion="1.2" xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" xs:noNamespaceSchemaLocation="PACK.xsd">
  <vendor>ArteryTek</vendor>
  <url></url>
  <name>AT32F403E_407E_DFP</name>
  <description>ArteryTek AT32F403E_407E Series Device Support,Drivers</description>
  <releases>
    <release version="2.0.1" date="2026-08-28" url="https://github.com/ArteryTek/Open-CMSIS-Pack/raw/main/ArteryTek.AT32F403E_407E_DFP.2.0.1.pack">
      change URL.
