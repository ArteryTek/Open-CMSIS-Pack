<?xml version="1.0" encoding="UTF-8"?>
<package schemaVersion="1.2" xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" xs:noNamespaceSchemaLocation="PACK.xsd">
  <vendor>ArteryTek</vendor>
  <url></url>
  <name>AT32F011_DFP</name>
  <description>ArteryTek AT32F0 Series Device Support,Drivers</description>
  <releases>
    <release version="2.0.2" date="2026-08-28" url="https://github.com/ArteryTek/Open-CMSIS-Pack/raw/main/ArteryTek.AT32F011_DFP.2.0.2.pack">
      change URL.
    </release>
  </releases>
  <keywords>
    <!-- keywords for indexing -->
    <keyword>ArteryTek</keyword>
    <keyword>AT32F011</keyword>
    <keyword>AT32F0</keyword>
  </keywords>

  <devices>
    <!-- ******************************  Cortex-M4  ********************** -->
    <family Dfamily="AT32F01x Series" Dvendor="ArteryTek:143">
      <!--book name="Device/ARM/Documents/??_dgug.pdf"       title="?? Device Generic Users Guide"/-->
    <processor Dcore="Cortex-M0+" DcoreVersion="r0p1" Dfpu="0" Dmpu="1" Dtz="NO_TZ" Dendian="Little-endian" />
    <compile header="Device/Include/at32f011.h"/>

      <description>
AT32F0 is a new 32-bit high performance, low power consumption universal microcontroller family powered by the ARM Cortex-M0+ RISC core,which targeted at various MCU application areas.
AT32F0 family integrates features to simplify system design and provide customers wide range of comprehensive and superior cost effective MCU portfolios with proven technology and great innovation.
      </description>

      <!-- ************************  Subfamily 'AT32F011'  **************************** -->
      <subFamily DsubFamily="AT32F011">
      <processor Dclock="80000000"/>
      <debug svd="SVD/AT32F011xx_v2.svd"/>
      <description>
AT32F011 - ARM Cortex-M0+ Core
  Frequency up to 80 MHz
  NVIC support 16 internal, 31 external interrupts, each has 4 priority levels

Memories
  Flash size up to 64KB
  SRAM size up to 9KB

Low power management
  Power saving mode: sleep, deep-sleep and standby mode
  Independent battery supply for real-calendar RTC and battry powered domain register

Advanced analog peripherals
  1 x 12bit ADC

Integrated peripherals interface
  Up to 4 x USART/UART/Irda/LIN/ISO7816
  Up to 2 x SPI
  Up to 2 x I2C

On-chip resources
  1 x 16 bit Advanced Timer, 1 x SysTick Timer, 5 x 16 bit GPTM, 2 x WDT, 1 x RTC
  5-chs DMA support: Timers, ADC, SPIs, I2Cs, USARTs
  System supervisor and reset: POR,PDR,LVD
  80% GPIO available
  32-bit CRC, 96-bit unique ID
  On-chip clock: HICK (8MHz), LICK (40KHz)
      </description>

      <feature type="WDT"           n="2"/>
      <feature type="RTC"           n="32768"/>
      <feature type="ADC"           n="1"       m="12"/>
      <feature type="Temp"          n="-40"     m="105"/>
      <feature type="VCC"           n="1.71"    m="3.60"/>

        <!-- *************************  Device 'AT32F011C8T7'  ***************************** -->
        <device Dname="AT32F011C8T7">
          <compile header="Device/Include/at32f011.h"  define="AT32F011C8T7"/>
          <memory id="IROM1"  access="rx"       start="0x08000000"  size="0x10000"     startup="1"   default="1"/>
          <memory id="IRAM1"  access="rwx"      start="0x20000000"  size="0x2400"      init   ="0"   default="1"/>
          <algorithm name="Flash/AT32F011_64.FLM"                     start="0x08000000" size="0x10000"   default="1"/>
          <algorithm name="Flash/AT32F011_BOOTMEM_AP.FLM"             start="0x1FFFE400" size="0x01000"   default="0"/>
          <algorithm name="Flash/AT32F011_USD.FLM"                    start="0x1FFFF800" size="0x00040"   default="0"/>
        </device>

        <!-- *************************  Device 'AT32F011K8U7-4'  ***************************** -->
        <device Dname="AT32F011K8U7-4">
          <compile header="Device/Include/at32f011.h"  define="AT32F011K8U7_4"/>
          <memory id="IROM1"  access="rx"       start="0x08000000"  size="0x10000"     startup="1"   default="1"/>
          <memory id="IRAM1"  access="rwx"      start="0x20000000"  size="0x2400"      init   ="0"   default="1"/>
          <algorithm name="Flash/AT32F011_64.FLM"                     start="0x08000000" size="0x10000"   default="1"/>
          <algorithm name="Flash/AT32F011_BOOTMEM_AP.FLM"             start="0x1FFFE400" size="0x01000"   default="0"/>
          <algorithm name="Flash/AT32F011_USD.FLM"                    start="0x1FFFF800" size="0x00040"   default="0"/>
        </device>

        <!-- *************************  Device 'AT32F011F8U7'  ***************************** -->
        <device Dname="AT32F011F8U7">
          <compile header="Device/Include/at32f011.h"  define="AT32F011F8U7"/>
          <memory id="IROM1"  access="rx"       start="0x08000000"  size="0x10000"     startup="1"   default="1"/>
          <memory id="IRAM1"  access="rwx"      start="0x20000000"  size="0x2400"      init   ="0"   default="1"/>
          <algorithm name="Flash/AT32F011_64.FLM"                     start="0x08000000" size="0x10000"   default="1"/>
          <algorithm name="Flash/AT32F011_BOOTMEM_AP.FLM"             start="0x1FFFE400" size="0x01000"   default="0"/>
          <algorithm name="Flash/AT32F011_USD.FLM"                    start="0x1FFFF800" size="0x00040"   default="0"/>
        </device>

        <!-- *************************  Device 'AT32F011F8P7'  ***************************** -->
        <device Dname="AT32F011F8P7">
          <compile header="Device/Include/at32f011.h"  define="AT32F011F8P7"/>
          <memory id="IROM1"  access="rx"       start="0x08000000"  size="0x10000"     startup="1"   default="1"/>
          <memory id="IRAM1"  access="rwx"      start="0x20000000"  size="0x2400"      init   ="0"   default="1"/>
          <algorithm name="Flash/AT32F011_64.FLM"                     start="0x08000000" size="0x10000"   default="1"/>
          <algorithm name="Flash/AT32F011_BOOTMEM_AP.FLM"             start="0x1FFFE400" size="0x01000"   default="0"/>
          <algorithm name="Flash/AT32F011_USD.FLM"                    start="0x1FFFF800" size="0x00040"   default="0"/>
        </device>

     </subFamily>
    </family>
  </devices>

  <conditions>
    <!-- Compiler Conditions -->
    <condition id="Compiler ARMCC">
      <require Tcompiler="ARMCC"/>
    </condition>

    <!-- Device Conditions -->
    <condition id="AT32F011xx">
      <description>ArteryTek AT32F011 Devices</description>
      <require Dvendor="ArteryTek:143" Dname="AT32F011*"/>
      <require Cclass="Device" Cgroup="Startup" />
    </condition>

    <condition id="AT32F011">
      <description>ArteryTek AT32F011 Devices</description>
      <accept condition="AT32F011xx"/>
    </condition>

    <condition id="AT32F011xx ARMCC">
      <description>ArteryTek AT32F011xx Series devices</description>
      <require Dvendor="ArteryTek:143" Dname="AT32F011*"/>
      <require condition="Compiler ARMCC"/>
    </condition>

    <!-- Device + CMSIS Conditions -->
    <condition id="AT32F011 CMSIS">
      <description>ArteryTek AT32F011 Devices and CMSIS-CORE</description>
      <require condition="AT32F011"/>
      <require Cclass="CMSIS" Cgroup="CORE"/>
      <require Cclass="Device" Cgroup="at32f011_conf"/>    
      <require Cclass="Device" Cgroup="at32f011_firmware_library" Csub="crm"/>           
    </condition>

    <!-- AT32F011 STDPERIPHERALS CRM Conditions -->
    <condition id="AT32F011 STDPERIPHERALS CRM">
      <description>ArteryTek AT32F011 Standard Peripherals Drivers with CRM</description>
      <require condition="AT32F011 CMSIS"/>
      <require Cclass="Device" Cgroup="at32f011_firmware_library" Csub="crm"/>
    </condition>

     <!-- AT32F011 STDPERIPHERALS MISC Conditions -->
    <condition id="AT32F011 STDPERIPHERALS MISC">
      <description>ArteryTek  AT32F011 Standard Peripherals Drivers with MISC</description>
      <require condition="AT32F011 CMSIS"/>
      <require Cclass="Device" Cgroup="at32f011_firmware_library" Csub="misc"/>
    </condition>

     <!-- AT32F011 STDPERIPHERALS EVAL Conditions -->
    <condition id="AT32F011 STDPERIPHERALS EVB">
      <description>ArteryTek AT32F011 Standard Peripherals Drivers with EVB</description>
      <require condition="AT32F011 CMSIS"/>
      <require Cclass="Device" Cgroup="at32f011_firmware_library" Csub="gpio"/>
      <require Cclass="Device" Cgroup="at32f011_firmware_library" Csub="exint"/>
      <require Cclass="Device" Cgroup="at32f011_firmware_library" Csub="usart"/>
      <require Cclass="Device" Cgroup="at32f011_firmware_library" Csub="syscfg"/>
    </condition>
  </conditions>

