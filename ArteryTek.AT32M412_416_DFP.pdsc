  <devices>
    <!-- ******************************  Cortex-M4  ********************** -->
    <family Dfamily="AT32M41x Series" Dvendor="ArteryTek:143">
      <!--book name="Device/ARM/Documents/??_dgug.pdf"       title="?? Device Generic Users Guide"/-->
    <processor Dcore="Cortex-M4" DcoreVersion="r0p1" Dfpu="1" Dmpu="1" Dtz="NO_TZ" Dendian="Little-endian" />
    <compile header="Device/Include/at32m412_416.h"/>

      <description>
AT32M4 is a new 32-bit high performance, low power consumption universal microcontroller family powered by the ARM Cortex-M4 RISC core,which targeted at various MCU application areas.
AT32M4 family integrates features to simplify system design and provide customers wide range of comprehensive and superior cost effective MCU portfolios with proven technology and great innovation.
      </description>    

      <!-- ************************  Subfamily 'AT32M412'  **************************** -->
      <subFamily DsubFamily="AT32M412">
      <processor  Dfpu="1" Dclock="180000000"/>
      <debug svd="SVD/AT32M412xx_v2.svd"/>
      <description>
AT32M412 - ARM Cortex-M4 Core
  Frequency up to 180 MHz
  Single-cycle multiplier and hardware divider
  NVIC support 16 internal, 28 external interrupts, each has 16 priority levels

Memories
  Flash size from 64KB up to 128KB
  SRAM size up to 16KB

Low power management
  Power saving mode: sleep,deep-sleep and standby mode

Advanced analog peripherals
  Up to 2 x 12bit ADC
  Up to 2 x CMP
  Up to 4 x OP

Integrated peripherals interface
  Up to 2 x USART/UART/Irda/LIN/ISO7816
  Up to 2 x SPI
  Up to 2 x I2C
  Up to 1 x CAN

On-chip resources
  Up to 1 x 16 bit Advanced Timer, 1 x SysTick Timer, 5 x 16 bit GPTM, 2 x WDT, 1 x ERTC
  7-chs DMA support: Timers, ADC, SPIs, I2Cs, USARTs
  System supervisor and reset: POR,PDR,LVD
  80% GPIO available
  32-bit CRC, 96-bit unique ID
  On-chip clock: HICK (8MHz/48MHz), LICK (40KHz)
      </description>

      <feature type="WDT"           n="2"/>
      <feature type="RTC"           n="32768"/>
      <feature type="ADC"           n="1"       m="12"/>
      <feature type="Temp"          n="-40"     m="105"/>
      <feature type="VCC"           n="2.40"    m="3.60"/>

        <!-- *************************  Device 'AT32M412CBT7'  ***************************** -->
        <device Dname="AT32M412CBT7">
          <compile header="Device/Include/at32m412_416.h"  define="AT32M412CBT7"/>
          <memory id="IROM1"  access="rx"       start="0x08000000"  size="0x20000"     startup="1"   default="1"/>
          <memory id="IRAM1"  access="rwx"      start="0x20000000"  size="0x4000"      init   ="0"   default="1"/>
          <algorithm name="Flash/AT32M412_128.FLM"                  start="0x08000000" size="0x20000"   default="1"/>
          <algorithm name="Flash/AT32M412_BOOTMEM_AP.FLM"           start="0x1FFF8000" size="0x07000"   default="0"/>
          <algorithm name="Flash/AT32M412_USD.FLM"                  start="0x1FFFF800" size="0x00200"   default="0"/>
        </device>

        <!-- *************************  Device 'AT32M412C8T7'  ***************************** -->
        <device Dname="AT32M412C8T7">
          <compile header="Device/Include/at32m412_416.h"  define="AT32M412C8T7"/>
