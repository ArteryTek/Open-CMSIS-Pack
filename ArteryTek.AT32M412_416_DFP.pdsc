          <algorithm name="Flash/AT32M412_64.FLM"                   start="0x08000000" size="0x10000"   default="1"/>
          <algorithm name="Flash/AT32M412_BOOTMEM_AP.FLM"           start="0x1FFF8000" size="0x07000"   default="0"/>
          <algorithm name="Flash/AT32M412_USD.FLM"                  start="0x1FFFF800" size="0x00200"   default="0"/>
        </device>

