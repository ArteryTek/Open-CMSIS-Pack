  <conditions>
    <!-- Compiler Conditions -->
    <condition id="Compiler ARMCC">
      <require Tcompiler="ARMCC"/>
    </condition>

    <!-- Device Conditions -->
    <condition id="AT32M412xx">
      <description>ArteryTek AT32M412 Devices</description>
      <require Dvendor="ArteryTek:143" Dname="AT32M412[CKE]*"/>
      <require Cclass="Device" Cgroup="Startup" />
    </condition>

    <!-- Device Conditions -->
    <condition id="AT32M416xx">
      <description>ArteryTek AT32M416 Devices</description>
      <require Dvendor="ArteryTek:143" Dname="AT32M416[CKE]*"/>
      <require Cclass="Device" Cgroup="Startup" />
    </condition>

    <condition id="AT32M412_416">
      <description>ArteryTek AT32M412_416 Devices</description>
      <accept condition="AT32M412xx"/>
      <accept condition="AT32M416xx"/>
    </condition>

    <condition id="AT32M412xx ARMCC">
      <description>ArteryTek AT32M412xx Series devices</description>
      <require Dvendor="ArteryTek:143" Dname="AT32M412[CFGK]*"/>
      <require condition="Compiler ARMCC"/>
    </condition>

    <condition id="AT32M416xx ARMCC">
      <description>ArteryTek AT32M416xx Series devices</description>
      <require Dvendor="ArteryTek:143" Dname="AT32M416[CFGK]*"/>
      <require condition="Compiler ARMCC"/>
    </condition>

    <!-- Device + CMSIS Conditions -->
    <condition id="AT32M412_416 CMSIS">
      <description>ArteryTek AT32M412_416 Devices and CMSIS-CORE</description>
      <require condition="AT32M412_416"/>
      <require Cclass="CMSIS" Cgroup="CORE"/>
      <require Cclass="Device" Cgroup="at32m412_416_conf"/>    
      <require Cclass="Device" Cgroup="at32m412_416_firmware_library" Csub="crm"/>           
    </condition>

    <!-- AT32M412_416 STDPERIPHERALS CRM Conditions -->
    <condition id="AT32M412_416 STDPERIPHERALS CRM">
      <description>ArteryTek AT32M412_416 Standard Peripherals Drivers with CRM</description>
      <require condition="AT32M412_416 CMSIS"/>
      <require Cclass="Device" Cgroup="at32m412_416_firmware_library" Csub="crm"/>
    </condition>

     <!-- AT32M412_416 STDPERIPHERALS MISC Conditions -->
    <condition id="AT32M412_416 STDPERIPHERALS MISC">
      <description>ArteryTek  AT32M412_416 Standard Peripherals Drivers with MISC</description>
      <require condition="AT32M412_416 CMSIS"/>
      <require Cclass="Device" Cgroup="at32m412_416_firmware_library" Csub="misc"/>
    </condition>

     <!-- AT32M412_416 STDPERIPHERALS EVAL Conditions -->
