  <name>AT32M412_416_DFP</name>
  <description>ArteryTek AT32M412_416 Series Device Support,Drivers</description>
  <releases>
    <release version="2.0.7" date="2026-11-16" url="https://github.com/ArteryTek/Open-CMSIS-Pack/raw/main/ArteryTek.AT32M412_416_DFP.2.0.7.pack">
      Update firmware library and svd file.
    </release>
    <release version="2.0.6" date="2026-08-28" url="https://github.com/ArteryTek/Open-CMSIS-Pack/raw/main/ArteryTek.AT32M412_416_DFP.2.0.6.pack">
